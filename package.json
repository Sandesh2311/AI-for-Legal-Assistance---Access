{
  "name": "lexiguide-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "node ./node_modules/vite/bin/vite.js",
    "dev:server": "node ./node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "test": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
